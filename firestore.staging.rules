rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get whitelist document for current user
    function getWhitelistData() {
      return get(/databases/$(database)/documents/whitelist_users/$(request.auth.token.email)).data;
    }

    // Helper to check if current user is whitelisted
    function isWhitelisted() {
      return isAuthenticated() && exists(/databases/$(database)/documents/whitelist_users/$(request.auth.token.email));
    }

    // Helper to check if user has super_admin role
    function isSuperAdmin() {
      return isWhitelisted() && getWhitelistData().role == 'super_admin';
    }

    // NEW: Helper to check company_id match
    function sameCompany(userCompany) {
      return request.auth.token.company_id == userCompany;
    }

    // Whitelist collection rules
    match /whitelist_users/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Projects rules — restricted to whitelisted users same company
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (sameCompany('co_hitec') || request.auth.uid == resource.data.userId || request.auth.token.email == resource.data.created_by || isWhitelisted());
      allow write: if isSuperAdmin();
      allow create: if isAuthenticated() && (sameCompany('co_hitec') || request.auth.uid == request.resource.data.userId || request.auth.token.email == request.resource.data.created_by || isWhitelisted());
    }

    // Photos rules — restricted to whitelisted users same company
    match /photos/{photoId} {
      allow read, write: if isAuthenticated() && sameCompany('co_hitec') ||
        (isAuthenticated() && request.auth.token.email == resource.data.uploaded_by);
      allow create: if isAuthenticated() && sameCompany('co_hitec') ||
        (isAuthenticated() && request.auth.token.email == request.resource.data.uploaded_by);
    }

    // Plan rules
    match /plan/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Feedback rules
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Sessions rules — restricted to whitelisted users same company
    match /sessions/{sessionId} {
      allow read, create, update, delete: if isAuthenticated() && sameCompany('co_hitec') && isWhitelisted();
    }

    // System Alerts rules — intentional open-create for unauthenticated Login.jsx failure path
    match /system_alerts/{alertId} {
      allow create: if true;
      allow read: if isWhitelisted();
      allow update, delete: if isSuperAdmin();
    }

    // Report Downloads rules
    match /report_downloads/{reportId} {
      allow read, update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isWhitelisted());
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isWhitelisted());
    }
  }
}
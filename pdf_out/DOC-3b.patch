diff --git a/tests/invoices/test_doc3.js b/tests/invoices/test_doc3.js
index 9e20591..dd83606 100644
--- a/tests/invoices/test_doc3.js
+++ b/tests/invoices/test_doc3.js
@@ -34,5 +34,33 @@ window.erpState.invoices.push({ receipt_no: '001/R/HTP/0926' });
 window.erpState.invoices.push({ receipt_no: '002/R/HTP/0926' });
 assertEq('Third receipt no for Sep 26', generateNextReceiptNo('2026-09-27'), '003/R/HTP/0926');
 
+// DOC-3b: spec cases DOC-3 left out
+assertEq('terbilangIDR 6966000', terbilangIDR(6966000), 'Enam juta sembilan ratus enam puluh enam ribu');
+assertEq('terbilangIDR 111', terbilangIDR(111), 'Seratus sebelas');
+assertEq('terbilangIDR 2015000', terbilangIDR(2015000), 'Dua juta lima belas ribu');
+assertEq('terbilangIDR 1000000', terbilangIDR(1000000), 'Satu juta');
+assertEq('terbilangIDR 1100000000', terbilangIDR(1100000000), 'Satu miliar seratus juta');
+
+assertEq('New month restarts at 001', generateNextReceiptNo('2026-10-02'), '001/R/HTP/1026');
+window.erpState.invoices.push({ invoice_no: '009/INV/HTP/1026' });
+assertEq('Invoice numbers never counted as receipts', generateNextReceiptNo('2026-10-02'), '001/R/HTP/1026');
+
+const cv = resolveProjectContractValue({ client_po: { po_no: 'X', po_value: 6966000, inclusive_tax: true } });
+assertEq('Inclusive PO -> DPP', cv.dpp, 6275676);
+assertEq('Inclusive PO -> total', cv.total, 6966000);
+
+// Text scan: invoice + receipt templates carry no grey text and no removed rows.
+const src = require('fs').readFileSync(require('path').join(__dirname, '../../js/invoices.js'), 'utf8');
+const slice = (from, to) => src.slice(src.indexOf(from), src.indexOf(to, src.indexOf(from)));
+const invTpl = slice('async function renderInvoicePdfDirect', 'window.renderInvoicePdfDirect');
+const rcpTpl = slice('async function exportReceiptPdf', 'window.exportReceiptPdf');
+for (const [name, tpl] of [['invoice', invTpl], ['receipt', rcpTpl]]) {
+  assertEq(`${name} template found`, tpl.length > 1000, true);
+  assertEq(`${name}: no grey #64748b/#475569/#94a3b8`, /#64748b|#475569|#94a3b8/i.test(tpl), false);
+  assertEq(`${name}: no CONTRACT SUB TOTAL`, tpl.includes('CONTRACT SUB TOTAL'), false);
+  assertEq(`${name}: no stamp image`, /buildStampSignatureHtml|hitec_stamp_signature/.test(tpl), false);
+  assertEq(`${name}: no page footer`, tpl.includes('drawPageFooters'), false);
+}
+
 console.log(`\nTests finished: ${passCount} PASS, ${failCount} FAIL`);
 if (failCount > 0) process.exitCode = 1;

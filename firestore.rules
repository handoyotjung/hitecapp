rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get whitelist document for current user
    function getWhitelistData() {
      return get(/databases/$(database)/documents/whitelist_users/$(request.auth.token.email)).data;
    }
    
    // Helper to check if current user is whitelisted
    function isWhitelisted() {
      return isAuthenticated() && exists(/databases/$(database)/documents/whitelist_users/$(request.auth.token.email));
    }
    
    // Helper to check if user has super_admin role
    function isSuperAdmin() {
      return isWhitelisted() && getWhitelistData().role == 'super_admin';
    }

    // Whitelist collection rules
    match /whitelist_users/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Projects rules — public read for progress dashboard
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.created_by ||
        isWhitelisted()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.token.email == request.resource.data.created_by ||
        isWhitelisted()
      );
    }

    // Photos rules
    match /photos/{photoId} {
      allow read, write: if isWhitelisted() ||
        (isAuthenticated() && request.auth.token.email == resource.data.uploaded_by);
      allow create: if isWhitelisted() ||
        (isAuthenticated() && request.auth.token.email == request.resource.data.uploaded_by);
    }

    // Plan rules
    match /plan/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Feedback rules
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Sessions rules — public read for progress dashboard
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isWhitelisted();
    }

    // System Alerts rules — intentional open-create for unauthenticated Login.jsx failure path
    match /system_alerts/{alertId} {
      allow create: if true;
      allow read: if isWhitelisted();
      allow update, delete: if isSuperAdmin();
    }

    // Client Surveys — public read/create, open write/delete for admin cleanup
    match /client_surveys/{surveyId} {
      allow read, write: if true;
    }

    // Report Downloads rules
    match /report_downloads/{reportId} {
      allow read, write: if true;
    }
  }
}
